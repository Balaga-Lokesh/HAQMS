generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  DOCTOR
  RECEPTIONIST
}

enum AppointmentStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum QueueStatus {
  WAITING
  CALLING
  COMPLETED
  SKIPPED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      UserRole @default(RECEPTIONIST)
  createdAt DateTime @default(now())
}

model Doctor {
  id              String        @id @default(cuid())
  name            String
  specialization  String
  department      String
  consultationFee Float
  experience      Int
  appointments    Appointment[]
  queueTokens     QueueToken[]
  createdAt       DateTime      @default(now())

  @@index([specialization])
  @@index([department])
}

model Patient {
  id             String        @id @default(cuid())
  name           String
  email          String?       @unique
  phoneNumber    String
  age            Int
  gender         String
  medicalHistory  String?
  appointments   Appointment[]
  queueTokens    QueueToken[]
  createdAt      DateTime      @default(now())

  @@index([phoneNumber])
  @@index([name])
}

model Appointment {
  id              String             @id @default(cuid())
  patientId       String
  doctorId        String
  appointmentDate DateTime
  reason          String?
  status          AppointmentStatus   @default(PENDING)

  patient         Patient @relation(fields: [patientId], references: [id])
  doctor          Doctor  @relation(fields: [doctorId], references: [id])

  createdAt       DateTime @default(now())

  @@index([doctorId])
  @@index([patientId])
  @@index([appointmentDate])
  @@unique([doctorId, appointmentDate])
}

model QueueToken {
  id            String      @id @default(cuid())
  tokenNumber   Int
  patientId     String
  doctorId      String
  appointmentId String?
  status        QueueStatus @default(WAITING)

  patient       Patient @relation(fields: [patientId], references: [id])
  doctor        Doctor  @relation(fields: [doctorId], references: [id])

  createdAt     DateTime @default(now())

  @@index([doctorId])
  @@index([patientId])
  @@unique([doctorId, tokenNumber])
}
